---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolShell from '../../components/tools/ToolShell.astro';
import '../../styles/tools.css';
---

<BaseLayout
	title="JSON 格式化"
	description="在线校验、美化与压缩 JSON，错误定位到具体行列。"
	pageKind="landing"
>
	<ToolShell
		active="json"
		title="JSON 格式化"
		description="校验、美化、压缩 JSON。解析失败会指出出错的行与列，全部处理都在浏览器本地完成。"
	>
		<div class="tool-panel">
			<div class="tool-field">
				<label for="json-input">JSON 输入</label>
				<textarea
					id="json-input"
					rows="12"
					spellcheck="false"
					placeholder={'{\n  "name": "LJ",\n  "tags": ["astro", "test"]\n}'}></textarea>
			</div>

			<div class="tool-actions">
				<button type="button" class="tool-btn tool-btn--primary" data-json-action="format">
					格式化
				</button>
				<button type="button" class="tool-btn" data-json-action="minify">压缩</button>
				<button type="button" class="tool-btn" data-json-action="escape">转义为字符串</button>
				<button type="button" class="tool-btn" data-json-action="clear">清空</button>
				<label class="tool-inline">
					缩进
					<select id="json-indent">
						<option value="2" selected>2 空格</option>
						<option value="4">4 空格</option>
						<option value="0">Tab</option>
					</select>
				</label>
			</div>

			<p class="tool-status" id="json-status" role="status" aria-live="polite"></p>

			<div class="tool-field">
				<div class="tool-field__head">
					<span>结果</span>
					<div class="tool-actions tool-actions--compact">
						<button type="button" class="tool-btn" data-json-action="copy">复制</button>
						<button type="button" class="tool-btn" data-json-action="download">下载</button>
						<button type="button" class="tool-btn" data-json-action="reuse">回填输入框</button>
					</div>
				</div>
				<pre class="tool-output" id="json-output" tabindex="0"></pre>
			</div>
		</div>
	</ToolShell>
</BaseLayout>

<script>
	import '../../scripts/tools/json.ts';
</script>
