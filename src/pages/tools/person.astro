---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolShell from '../../components/tools/ToolShell.astro';
import { PERSON_FIELDS, FIELD_LABELS, MAX_COUNT } from '../../lib/tools/person';
import '../../styles/tools.css';

const DEFAULT_ON: string[] = ['name', 'gender', 'idCard', 'phone', 'address'];
---

<BaseLayout
	title="人员数据生成"
	description="批量生成姓名、身份证、手机号、银行卡等测试数据，校验位真实可用。"
	pageKind="landing"
>
	<ToolShell
		active="person"
		title="人员数据生成"
		description="批量造测试数据。身份证带正确校验位且与性别、出生日期自洽，银行卡按 Luhn 算法生成，全部为随机虚构。"
	>
		<div class="tool-panel">
			<div class="tool-actions">
				<label class="tool-inline">
					生成数量
					<input id="person-count" type="number" min="1" max={MAX_COUNT} value="10" />
				</label>
				<label class="tool-inline">
					格式
					<select id="person-format">
						<option value="json" selected>JSON</option>
						<option value="csv">CSV</option>
					</select>
				</label>
			</div>

			<fieldset class="tool-fieldset">
				<legend>包含字段</legend>
				{
					PERSON_FIELDS.map((field) => (
						<label class="tool-check">
							<input type="checkbox" value={field} checked={DEFAULT_ON.includes(field)} />
							<span>{FIELD_LABELS[field]}</span>
						</label>
					))
				}
			</fieldset>

			<div class="tool-actions">
				<button type="button" class="tool-btn tool-btn--primary" data-person-action="generate">
					生成
				</button>
				<button type="button" class="tool-btn" data-person-action="copy">复制</button>
				<button type="button" class="tool-btn" data-person-action="download">下载</button>
				<button type="button" class="tool-btn" data-person-action="clear">清空</button>
			</div>

			<p class="tool-status" id="person-status" role="status" aria-live="polite"></p>

			<pre class="tool-output" id="person-output" tabindex="0"></pre>
		</div>
	</ToolShell>
</BaseLayout>

<script>
	import '../../scripts/tools/person.ts';
</script>
