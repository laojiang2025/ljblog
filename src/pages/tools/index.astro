---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { TOOLS } from '../../data/tools';

const ready = TOOLS.filter((tool) => tool.status === 'ready').length;
const pending = TOOLS.length - ready;
const categoryOf = (category?: string) => category?.trim() || '通用';
const categories = [...new Set(TOOLS.map((tool) => categoryOf(tool.category)))];
---

<BaseLayout
	title="测试工具箱"
	description="纯前端的日常测试辅助工具，全部在浏览器本地运行，不上传任何数据。"
	pageKind="landing"
>
	<div class="mx-auto w-full max-w-[1920px] px-8 py-20 lg:px-16 2xl:px-20 lg:py-28">
		<header class="max-w-4xl">
			<p class="font-mono text-xs tracking-[0.18em] text-accent uppercase">Tools</p>
			<h1 class="mt-4 text-4xl font-bold tracking-tight md:text-5xl">测试工具箱</h1>
			<p class="mt-4 max-w-3xl text-base leading-relaxed text-muted">
				日常测试用得上的 {TOOLS.length} 个小工具，全部在浏览器本地运行，输入内容不会离开你的电脑。{
					pending > 0 && `其中 ${ready} 个已可用，其余正陆续迁移。`
				}
			</p>
		</header>

		{
			categories.length > 1 && (
				<div class="mt-10 flex flex-wrap gap-2" data-tool-filters>
					<button class="tool-chip" type="button" data-tool-filter="" aria-pressed="true">
						全部
					</button>
					{categories.map((category) => (
						<button class="tool-chip" type="button" data-tool-filter={category} aria-pressed="false">
							{category}
						</button>
					))}
				</div>
			)
		}

		<div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-tool-list>
			{
				TOOLS.map((tool) => {
					const body = (
						<>
							<span class="inline-grid size-9 shrink-0 place-items-center rounded-md bg-surface-hover text-muted transition-colors group-hover:bg-accent-soft group-hover:text-accent">
								<Icon name={tool.icon} class="size-4.5" />
							</span>
							<span class="min-w-0">
								<span class="block text-base font-medium">{tool.name}</span>
								<span class="mt-1.5 block text-sm leading-relaxed text-muted">
									{tool.summary}
								</span>
							</span>
							<span class="tag-pill pointer-events-none absolute right-3 bottom-3 hidden sm:inline-flex">
								{categoryOf(tool.category)}
							</span>
						</>
					);

					const external = /^https?:\/\//.test(tool.href ?? '');
					return tool.href ? (
						<a
							class="group relative flex items-start gap-4 rounded-[18px] border border-border bg-background/85 p-5 pb-8 shadow-(--shadow-sm) transition-all hover:-translate-y-1 hover:border-border-strong hover:shadow-(--shadow-md)"
							href={tool.href}
							target={external ? '_blank' : undefined}
							rel={external ? 'noopener noreferrer' : undefined}
							data-tool-item
							data-category={categoryOf(tool.category)}
						>
							{body}
						</a>
					) : (
						<div
							class="relative flex items-start gap-4 rounded-lg border border-dashed border-border p-5 pb-8 opacity-70"
							data-tool-item
							data-category={categoryOf(tool.category)}
						>
							{body}
							<span class="tag-pill absolute top-3 right-3">迁移中</span>
						</div>
					);
				})
			}
		</div>
		<p class="mt-8 hidden text-sm text-faint" data-tool-empty>这个分类下暂时没有工具。</p>
	</div>
</BaseLayout>

<style>
	.tool-chip {
		padding: 0.45rem 1.1rem;
		border: 1px solid var(--border);
		border-radius: 9999px;
		background: color-mix(in srgb, var(--surface) 88%, transparent);
		font-size: 14px;
		color: var(--text-muted);
		cursor: pointer;
		transition:
			color 0.15s ease,
			border-color 0.15s ease,
			background 0.15s ease;
	}
	.tool-chip:hover {
		border-color: var(--border-strong);
		color: var(--text);
	}
	.tool-chip[aria-pressed='true'] {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--bg);
	}
</style>

<script>
	function initToolFilters() {
		const list = document.querySelector<HTMLElement>('[data-tool-list]');
		if (!list || list.dataset.bound) return;
		list.dataset.bound = '1';

		const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-tool-filter]')];
		const items = [...list.querySelectorAll<HTMLElement>('[data-tool-item]')];
		const empty = document.querySelector<HTMLElement>('[data-tool-empty]');

		for (const chip of chips) {
			chip.addEventListener('click', () => {
				const active = chip.dataset.toolFilter ?? '';
				chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
				let visible = 0;
				for (const item of items) {
					const show = !active || item.dataset.category === active;
					item.hidden = !show;
					if (show) visible += 1;
				}
				empty?.classList.toggle('hidden', visible > 0);
			});
		}
	}

	document.addEventListener('astro:page-load', initToolFilters);
	initToolFilters();
</script>
