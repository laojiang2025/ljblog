---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolShell from '../../components/tools/ToolShell.astro';
import '../../styles/tools.css';

const PARTS = [
	{ id: 'protocol', label: '协议' },
	{ id: 'hostname', label: '主机' },
	{ id: 'port', label: '端口' },
	{ id: 'pathname', label: '路径' },
	{ id: 'search', label: '查询串' },
	{ id: 'hash', label: 'Hash' },
	{ id: 'origin', label: 'Origin' },
];
---

<BaseLayout
	title="URL 解析"
	description="拆解 URL 的各个组成部分与查询参数，并提供编解码。"
	pageKind="landing"
>
	<ToolShell
		active="url"
		title="URL 解析"
		description="拆开协议、主机、路径与每一个查询参数。省略协议时按 https 补全，解析全在本地完成。"
	>
		<div class="tool-panel">
			<div class="tool-field">
				<label for="url-input">URL</label>
				<textarea
					id="url-input"
					rows="3"
					spellcheck="false"
					placeholder="https://example.com/search?q=astro&page=2#result"></textarea>
			</div>

			<div class="tool-actions">
				<button type="button" class="tool-btn tool-btn--primary" data-url-action="parse">
					解析
				</button>
				<button type="button" class="tool-btn" data-url-action="encode">编码</button>
				<button type="button" class="tool-btn" data-url-action="decode">解码</button>
				<button type="button" class="tool-btn" data-url-action="clear">清空</button>
			</div>

			<p class="tool-status" id="url-status" role="status" aria-live="polite"></p>

			<dl class="tool-result">
				{
					PARTS.map((part) => (
						<div class="tool-result__row">
							<dt>{part.label}</dt>
							<dd>
								<output id={`url-${part.id}`}>—</output>
							</dd>
						</div>
					))
				}
			</dl>

			<div class="tool-field">
				<div class="tool-field__head">
					<span>查询参数</span>
					<span class="tool-count" id="url-param-count"></span>
				</div>
				<table class="tool-table">
					<thead>
						<tr>
							<th scope="col">参数名</th>
							<th scope="col">值</th>
						</tr>
					</thead>
					<tbody id="url-params">
						<tr class="tool-table__empty">
							<td colspan="2">还没有解析结果</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>
	</ToolShell>
</BaseLayout>

<script>
	import '../../scripts/tools/url.ts';
</script>
