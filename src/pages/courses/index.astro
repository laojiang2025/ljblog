---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { COURSES } from '../../data/courses';
import { SITE } from '../../consts';
import '../../styles/content.css';

const description = `${SITE.author} 的 AI 测试课程：把测试工程与 AI 工作流的实战经验做成体系化课程。`;
---

<BaseLayout title="AI 课程" description={description} pageKind="landing">
	<div class="content-shell content-shell--wide">
		<p class="page-kicker">AI Testing Courses</p>
		<h1 class="page-title">AI 测试课程</h1>
		<p class="page-lead">
			把测试工程与 AI 工作流的实战经验，整理成可以跟着做的体系化课程。已上线的可以直接报名，筹备中的会陆续开放。
		</p>

		<div class="mt-10 grid gap-4 sm:grid-cols-2">
			{
				COURSES.map((course) => {
					const isLive = course.status === 'live' && course.href;
					const card = (
						<>
							<div class="flex items-start justify-between gap-3">
								<span class="inline-grid size-11 place-items-center rounded-[11px] bg-accent-soft text-accent">
									<Icon name="play" class="size-5" />
								</span>
								<span class="flex items-center gap-2">
									{course.price && <span class="font-mono text-sm font-semibold text-accent">{course.price}</span>}
									<span
										class={`rounded-full px-2.5 py-1 font-mono text-[11px] font-semibold tracking-[0.08em] uppercase ${
											isLive ? 'bg-accent-soft text-accent' : 'bg-surface-hover text-faint'
										}`}
									>
										{isLive ? 'Live' : 'Coming'}
									</span>
								</span>
							</div>
							<h2 class="mt-4 text-xl font-semibold tracking-tight">{course.name}</h2>
							<p class="mt-1.5 text-base font-medium text-muted">{course.tagline}</p>
							<p class="mt-2.5 text-[15px] leading-relaxed text-muted">{course.description}</p>
							<div class="mt-4 flex flex-wrap items-center gap-1.5">
								{course.tags.map((tag) => (
									<span class="tag-pill">{tag}</span>
								))}
							</div>
							{isLive && <span class="home-card-arrow mt-4 inline-flex">开始学习 <span aria-hidden="true">↗</span></span>}
						</>
					);
					const cardClass =
						'group flex flex-col rounded-[20px] border border-border bg-surface/85 p-6 shadow-(--shadow-sm)';
					return isLive ? (
						<a
							class={`${cardClass} transition-all hover:-translate-y-1 hover:border-border-strong hover:shadow-(--shadow-md)`}
							href={course.href}
							target={/^https?:\/\//.test(course.href ?? '') ? '_blank' : undefined}
							rel={/^https?:\/\//.test(course.href ?? '') ? 'noopener noreferrer' : undefined}
						>
							{card}
						</a>
					) : (
						<article class={`${cardClass} opacity-80`}>{card}</article>
					);
				})
			}
		</div>

		<p class="mt-10 text-sm text-faint">课程筹备期间想聊需求或提前占座？去<a class="underline" href="/about/">关于页</a>找到联系方式。</p>
	</div>
</BaseLayout>
