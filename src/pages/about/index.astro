---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChannelList from '../../components/ChannelList.astro';
import Icon from '../../components/Icon.astro';
import { SITE } from '../../consts';
import { READY_TOOLS } from '../../data/tools';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latest = posts.slice(0, 4);
const questions = (await getCollection('interview')).filter((entry) => !entry.data.draft);

const sections = [
	{
		title: '测试工具箱',
		description: `${READY_TOOLS.length} 个纯前端工具，打开即用`,
		icon: 'flask' as const,
		href: '/tools/',
	},
	{
		title: '面试题库',
		description: `${questions.length} 道题附参考答案与追问`,
		icon: 'checklist' as const,
		href: '/interview/',
	},
	{
		title: '文章',
		description: `${posts.length} 篇实践笔记，可订阅 RSS`,
		icon: 'book' as const,
		href: '/blog/',
	},
];

const formatDate = (date: Date) =>
	date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });

const description = `关于 ${SITE.author}：我在做的事、关注渠道与最新文章。`;
---

<BaseLayout title="关于" description={description} pageKind="landing">
	<div class="mx-auto w-full max-w-[1600px] px-8 py-20 lg:px-16 lg:py-28">
		<!-- 个人介绍 -->
		<header class="flex flex-col gap-6 rounded-[24px] border border-border bg-surface/85 p-6 shadow-(--shadow-md) sm:flex-row sm:items-start sm:p-8">
			<div
				class="grid size-20 shrink-0 place-items-center rounded-[20px] bg-foreground font-mono text-xl font-semibold text-background shadow-(--shadow-md)"
				aria-hidden="true"
			>
				{SITE.author}
			</div>
			<div>
				<h1 class="text-4xl font-bold tracking-tight">Hi, 我是 {SITE.author}</h1>
				<p class="mt-2 text-base text-accent">测试开发 · 把工具与知识沉淀成一个站点</p>
				<p class="mt-4 text-base leading-relaxed text-muted">{SITE.description}</p>
				<ul class="mt-4 flex flex-wrap gap-1.5" aria-label="关注领域">
					{SITE.tags.map((tag) => <li class="tag-pill">{tag}</li>)}
				</ul>
			</div>
		</header>

		<!-- 站内内容 -->
		<section class="mt-14" aria-labelledby="site-map-title">
			<h2 id="site-map-title" class="text-lg font-semibold tracking-tight">这个站上有什么</h2>
			<div class="mt-5 grid gap-3 sm:grid-cols-3">
				{
					sections.map((section) => (
						<a
							class="group rounded-[18px] border border-border bg-surface/80 p-5 shadow-(--shadow-sm) transition-all hover:-translate-y-1 hover:border-border-strong hover:shadow-(--shadow-md)"
							href={section.href}
						>
							<span class="inline-grid size-8 place-items-center rounded-md bg-surface-hover text-muted transition-colors group-hover:bg-accent-soft group-hover:text-accent">
								<Icon name={section.icon} class="size-4" />
							</span>
							<h3 class="mt-3 text-sm font-medium">{section.title}</h3>
							<p class="mt-1 text-[13px] text-muted">{section.description}</p>
						</a>
					))
				}
			</div>
		</section>

		<!-- 关注渠道 -->
		<section class="mt-14" aria-labelledby="channels-title">
			<h2 id="channels-title" class="text-lg font-semibold tracking-tight">关注渠道</h2>
			<p class="mt-1.5 text-sm text-muted">在这些平台也能找到我，微信公众号点开即可看二维码。</p>
			<div class="mt-5">
				<ChannelList />
			</div>
		</section>

		<!-- 最新文章 -->
		<section class="mt-14" aria-labelledby="latest-title">
			<div class="flex items-end justify-between gap-4">
				<h2 id="latest-title" class="text-lg font-semibold tracking-tight">最新文章</h2>
				<a class="text-sm text-muted transition-colors hover:text-foreground" href="/blog/">
					查看全部 →
				</a>
			</div>
			{
				latest.length > 0 ? (
					<ul class="mt-4 divide-y divide-border">
						{latest.map((post) => (
							<li>
								<a
									class="group flex items-baseline justify-between gap-6 py-3.5"
									href={`/blog/${post.id}/`}
								>
									<span class="min-w-0">
										<span class="block truncate text-sm font-medium transition-colors group-hover:text-accent">
											{post.data.title}
										</span>
										<span class="mt-0.5 line-clamp-1 block text-[13px] text-muted">
											{post.data.description}
										</span>
									</span>
									<time
										class="shrink-0 font-mono text-xs text-faint"
										datetime={post.data.pubDate.toISOString()}
									>
										{formatDate(post.data.pubDate)}
									</time>
								</a>
							</li>
						))}
					</ul>
				) : (
					<p class="mt-4 text-sm text-faint">还没有发布的文章。</p>
				)
			}
		</section>
	</div>
</BaseLayout>
