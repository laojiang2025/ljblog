---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChannelList from '../../components/ChannelList.astro';
import Icon from '../../components/Icon.astro';
import { SITE } from '../../consts';
import { WORKSTATION_SECTIONS, WORKSTATION_STATS } from '../../data/workstation';
import '../../styles/about.css';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latest = posts.slice(0, 4);

const formatDate = (date: Date) =>
	date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });

const description = `关于 ${SITE.author}：我在做的事、关注渠道与最新笔记。`;
---

<BaseLayout title="关于" description={description}>
	<div class="about">
		<header class="about-hero">
			<div class="about-hero__portrait" aria-hidden="true">LJ</div>
			<div class="about-hero__copy">
				<h1>Hi, 我是 {SITE.author}</h1>
				<p class="about-hero__role">全栈开发者 · 把效率工具搭成自己的工作台</p>
				<p class="about-hero__desc">{SITE.description}</p>
				<ul class="pattern-tag-list" aria-label="关注领域">
					{SITE.tags.map((tag) => <li>{tag}</li>)}
				</ul>
			</div>
		</header>

		<section class="about-block" id="channels" aria-labelledby="channels-title">
			<h2 id="channels-title">关注渠道</h2>
			<p class="about-block__hint">在这些平台也能找到我，微信公众号点开即可看二维码。</p>
			<ChannelList />
		</section>

		<section class="about-block" aria-labelledby="doing-title">
			<div class="about-block__head">
				<h2 id="doing-title">我在做的事</h2>
				<a class="pattern-action-link" href="/">进入工作台</a>
			</div>
			<p class="about-block__hint">
				目前收录 {WORKSTATION_STATS.total} 项，其中 {WORKSTATION_STATS.live} 项已可用。
			</p>
			<div class="about-grid">
				{
					WORKSTATION_SECTIONS.map((section) => (
						<a class="about-card" href={`/#${section.id}`} data-accent={section.accent}>
							<span class="about-card__icon">
								<Icon name={section.icon} />
							</span>
							<span class="about-card__body">
								<span class="about-card__title">{section.title}</span>
								<span class="about-card__desc">{section.description}</span>
								<span class="about-card__count">{section.cards.length} 项</span>
							</span>
						</a>
					))
				}
			</div>
		</section>

		<section class="about-block" aria-labelledby="latest-title">
			<div class="about-block__head">
				<h2 id="latest-title">最新笔记</h2>
				<a class="pattern-action-link" href="/blog/">查看全部</a>
			</div>
			{
				latest.length > 0 ? (
					<ul class="about-posts">
						{latest.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									<span class="about-posts__title">{post.data.title}</span>
									<span class="about-posts__desc">{post.data.description}</span>
								</a>
								<time datetime={post.data.pubDate.toISOString()}>
									{formatDate(post.data.pubDate)}
								</time>
							</li>
						))}
					</ul>
				) : (
					<p class="about-block__hint">还没有发布的笔记。</p>
				)
			}
		</section>
	</div>
</BaseLayout>
