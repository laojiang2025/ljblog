---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { SKILLS } from '../../data/skills';
import { SITE } from '../../consts';
import '../../styles/content.css';

const description = `${SITE.author} 的开源 Agent Skills：让 AI 助手掌握测试工程的可复用能力。`;
---

<BaseLayout title="Skills" description={description} pageKind="landing">
	<div class="content-shell content-shell--wide">
		<p class="page-kicker">Open-source Skills</p>
		<h1 class="page-title">开源 Skills</h1>
		<p class="page-lead">
			把测试工程的经验封装成 Agent Skill 开源出来：装进你的 AI 助手，它就多一项可靠的能力。
		</p>

		<div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{
				SKILLS.map((skill) => {
					const hasRepo = Boolean(skill.repo);
					const card = (
						<>
							<div class="flex items-start justify-between gap-3">
								<span class="inline-grid size-10 place-items-center rounded-[10px] bg-accent-soft text-accent">
									<Icon name="cpu" class="size-4.5" />
								</span>
								{hasRepo ? (
									<span class="inline-flex items-center gap-1 font-mono text-xs text-muted">
										GitHub <Icon name="external" class="size-3.5" />
									</span>
								) : (
									<span class="rounded-full bg-surface-hover px-2.5 py-1 font-mono text-[11px] text-faint">仓库整理中</span>
								)}
							</div>
							<h2 class="mt-4 text-lg font-semibold tracking-tight">{skill.name}</h2>
							<p class="mt-2 text-[15px] leading-relaxed text-muted">{skill.summary}</p>
							{skill.usage && (
								<code class="mt-3 block truncate rounded-md bg-surface-hover px-3 py-2 font-mono text-xs text-muted">
									{skill.usage}
								</code>
							)}
							<div class="mt-4 flex flex-wrap gap-1.5">
								{skill.tags.map((tag) => (
									<span class="tag-pill">{tag}</span>
								))}
							</div>
						</>
					);
					const cardClass =
						'group flex flex-col rounded-[18px] border border-border bg-surface/85 p-5 shadow-(--shadow-sm)';
					return hasRepo ? (
						<a
							class={`${cardClass} transition-all hover:-translate-y-1 hover:border-border-strong hover:shadow-(--shadow-md)`}
							href={skill.repo}
							target="_blank"
							rel="noopener noreferrer"
						>
							{card}
						</a>
					) : (
						<article class={`${cardClass} opacity-80`}>{card}</article>
					);
				})
			}
		</div>

		<p class="mt-10 text-sm text-faint">
			什么是 Agent Skill？一份教 AI 助手完成特定任务的说明书（SKILL.md），放进支持的编辑器或 CLI
			就能生效。
		</p>
	</div>
</BaseLayout>
