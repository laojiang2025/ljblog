---
import { SITE } from '../consts';
import ChannelList from './ChannelList.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="site-footer__inner">
		<div class="site-footer__brand">
			<span class="site-footer__name">{SITE.title}</span>
			<p class="site-footer__desc">{SITE.description}</p>
		</div>

		<div class="site-footer__channels">
			<p class="site-footer__label">关注我</p>
			<ChannelList variant="compact" />
		</div>

		<nav class="site-footer__links" aria-label="页脚导航">
			<a href="/">工作台</a>
			<a href="/blog/">资料库</a>
			<a href="/about/">关于</a>
			<a href="/rss.xml">RSS</a>
		</nav>
	</div>
	<p class="site-footer__copy">© {year} {SITE.author}</p>
</footer>
