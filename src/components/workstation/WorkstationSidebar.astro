---
import Icon from '../Icon.astro';
import { FEATURED_LINKS, ACCESS_META } from '../../data/workstation';
---

<aside class="ws-side" aria-label="常用直达">
	<p class="ws-side__label">常用直达</p>
	<nav>
		<ul class="ws-side__list">
			{
				FEATURED_LINKS.map((link) => (
					<li>
						<a
							class="ws-side__link"
							href={link.href}
							data-accent={link.accent}
							title={ACCESS_META[link.access].hint}
						>
							<span class="ws-side__icon">
								<Icon name={link.icon} />
							</span>
							<span class="ws-side__text">{link.label}</span>
							{link.access === 'local' && <span class="ws-side__dot" aria-label="本机运行" />}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</aside>
