---
import { SITE } from '../consts';

interface Props {
	/** compact 用于页脚，横向排布；full 用于关于页，带说明文字 */
	variant?: 'compact' | 'full';
}

const { variant = 'full' } = Astro.props;
---

<ul class="channel-list" data-variant={variant}>
	{
		SITE.channels.map((channel) =>
			'panel' in channel ? (
				<li>
					{/* 微信没有可跳转地址，用 details 就地展开二维码，避免为它单开一套弹层 */}
					<details class="channel-item channel-item--panel">
						<summary>
							<span>{channel.label}</span>
							<span aria-hidden="true">＋</span>
						</summary>
						<div class="channel-qr">
							把公众号二维码放到 <code>public/qr-wechat.png</code> 后替换此处
						</div>
					</details>
				</li>
			) : (
				<li>
					<a class="channel-item" href={channel.href} target="_blank" rel="noopener noreferrer">
						<span>{channel.label}</span>
						<span aria-hidden="true">↗</span>
					</a>
				</li>
			),
		)
	}
</ul>
