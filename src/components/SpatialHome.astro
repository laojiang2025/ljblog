---
import type { CollectionEntry } from 'astro:content';
import { HOME_EDGES, HOME_NODES, SITE, type HomeNodeId } from '../consts';
import { WORKSTATION_SECTIONS } from '../data/workstation';
import SpatialSectionNode from './spatial/SpatialSectionNode.astro';
import '../styles/spatial-home.css';

interface Props {
	latestPosts: CollectionEntry<'blog'>[];
	archiveCount: number;
}

const { latestPosts, archiveCount } = Astro.props;

const formatDate = (date: Date) =>
	date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });

const profileJson = `{
  "name": "${SITE.author}",
  "role": "Full-stack Engineer",
  "focus": "AI & Productivity",
  "mode": "Always exploring"
}`;

const isHomeNodeId = (value: string): value is HomeNodeId => value in HOME_NODES;

// 分区节点与工作台共用一份数据，坐标另由 HOME_NODES 提供；
// 没有配坐标的分区会被自然跳过，新增分区时补个坐标即可上图
const sectionNodes = WORKSTATION_SECTIONS.filter((section) => isHomeNodeId(section.id)).map(
	(section) => {
		const nodeId = section.id as HomeNodeId;
		return { section, nodeId, layout: HOME_NODES[nodeId] };
	},
);
---

<div class="home-shell">
	<div class="spatial-home" data-home-variant="spatial" data-home-experience>
		<div
			class="home-map"
			data-home-map
			tabindex="0"
			role="region"
			aria-label={`${SITE.title}节点图`}
			aria-describedby="home-map-instructions"
		>
			<p class="sr-only" id="home-map-instructions">
				桌面端可以拖动画布、使用滚轮或方向键浏览，也可以使用右下角按钮定位卡片。移动端按普通页面顺序阅读。
			</p>

			<div class="home-map__scene" data-home-scene>
				<svg class="home-connectors" data-home-connectors aria-hidden="true" focusable="false">
					{
						HOME_EDGES.map((edge) => (
							<g
								class="home-connector"
								data-home-edge={edge.id}
								data-edge-from={edge.from}
								data-edge-to={edge.to}
							>
								<path class="home-connector__path" data-edge-path />
								<circle class="home-connector__dot" r="2">
									<animateMotion data-edge-motion dur="6s" repeatCount="indefinite" />
								</circle>
							</g>
						))
					}
				</svg>

				<div class="home-map__flow">
					<section
						id={HOME_NODES.person_lj.id}
						class="home-node home-node--person"
						data-home-node="person_lj"
						style={`--node-x:${HOME_NODES.person_lj.x}px;--node-y:${HOME_NODES.person_lj.y}px;--node-width:${HOME_NODES.person_lj.width}px`}
						tabindex="-1"
						aria-labelledby="lj-title"
					>
						<header class="system-node-header home-node__header">
							<span class="system-node-header__type home-node__type">人物</span>
							<span class="home-node__separator" aria-hidden="true">·</span>
							<span class="home-node__id">lj</span>
						</header>
						<div class="home-node__body">
							<div class="home-profile">
								<div class="home-profile__identity">
									<div class="home-profile__portrait" aria-hidden="true">LJ</div>
									<div class="home-profile__copy">
										<h1 id="lj-title" class="home-profile__greeting">
											Hi, 我是 {SITE.author}
										</h1>
										<p class="home-profile__role">全栈开发者</p>
										<p class="home-profile__role">把效率工具搭成自己的工作台</p>
									</div>
								</div>
								<ul class="pattern-tag-list" aria-label="关注领域">
									{SITE.tags.map((tag) => <li>{tag}</li>)}
								</ul>
								<pre class="home-profile__json" aria-label="个人信息 JSON 示例"><code>{profileJson}</code></pre>
								<div class="home-profile__channels">
									<p class="home-node__description">在这些平台也能找到我：</p>
									<ul class="home-channel-list">
										{
											SITE.channels.map((channel) => (
												<li>
													{'panel' in channel ? (
														<button type="button" data-open-home-panel={channel.panel}>
															<span>{channel.label}</span>
															<span aria-hidden="true">→</span>
														</button>
													) : (
														<a href={channel.href} target="_blank" rel="noopener noreferrer">
															<span>{channel.label}</span>
															<span aria-hidden="true">↗</span>
														</a>
													)}
												</li>
											))
										}
									</ul>
								</div>
							</div>
						</div>
					</section>

					{
						sectionNodes.map(({ section, nodeId, layout }) => (
							<SpatialSectionNode nodeId={nodeId} layout={layout} section={section}>
								{section.id === 'notes' && (
									<div class="home-archive">
										<p class="home-archive__count">
											<strong>{archiveCount}</strong>
											<span>条资料</span>
										</p>
										<div class="home-latest-list">
											{latestPosts.map((post) => (
												<article class="home-latest-item">
													<div class="home-latest-item__meta">
														<time datetime={post.data.pubDate.toISOString()}>
															{formatDate(post.data.pubDate)}
														</time>
													</div>
													<h3>
														<a href={`/blog/${post.id}/`}>{post.data.title}</a>
													</h3>
												</article>
											))}
										</div>
									</div>
								)}
							</SpatialSectionNode>
						))
					}
				</div>
			</div>

			<div class="home-map__controls" data-home-controls data-no-pan aria-label="画布节点定位">
				<button type="button" data-home-origin aria-label="回到画布起点">
					<span>起点</span>
				</button>
				{
					sectionNodes.map(({ section, nodeId }) => (
						<button
							type="button"
							data-home-target={nodeId}
							aria-label={`定位到${section.title}`}
						>
							<span>{section.title}</span>
						</button>
					))
				}
			</div>
		</div>

		<dialog class="detail-drawer" data-detail-drawer aria-labelledby="detail-drawer-title">
			<div class="detail-drawer__shell">
				<header class="detail-drawer__header">
					<span id="detail-drawer-title" data-detail-drawer-title>详情</span>
					<button
						type="button"
						class="detail-drawer__close"
						data-close-detail-drawer
						aria-label="关闭详情面板"
					>
						✕
					</button>
				</header>
				<div class="detail-drawer__content">
					<section data-drawer-panel="wechat" hidden>
						<div class="drawer-panel__intro">
							<p class="drawer-panel__eyebrow">频道 · channels</p>
							<h2>关注 {SITE.title}</h2>
						</div>
						<article class="drawer-qr-card">
							<header class="drawer-qr-card__header">
								<strong>微信公众号</strong>
								<span>wechat</span>
							</header>
							<div class="drawer-qr-placeholder">
								把公众号二维码放到
								<br />
								<code>public/qr-wechat.png</code>
								<br />
								后替换此处即可
							</div>
						</article>
					</section>
				</div>
			</div>
		</dialog>
	</div>
</div>

<script>
	import '../scripts/spatial-home.ts';
</script>
