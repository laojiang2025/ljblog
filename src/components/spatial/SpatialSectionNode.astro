---
import Icon from '../Icon.astro';
import { ACCESS_META, type WorkstationSection } from '../../data/workstation';
import type { HomeNodeId } from '../../consts';

interface Props {
	nodeId: HomeNodeId;
	layout: { id: string; x: number; y: number; width: number };
	section: WorkstationSection;
}

const { nodeId, layout, section } = Astro.props;
const titleId = `${layout.id}-title`;
---

<section
	id={layout.id}
	class="home-node home-node--section"
	data-home-node={nodeId}
	data-accent={section.accent}
	style={`--node-x:${layout.x}px;--node-y:${layout.y}px;--node-width:${layout.width}px`}
	tabindex="-1"
	aria-labelledby={titleId}
>
	<header class="system-node-header home-node__header">
		<span class="home-node__type">分区</span>
		<span class="home-node__separator" aria-hidden="true">·</span>
		<span class="home-node__id">{layout.id}</span>
	</header>
	<div class="home-node__body">
		<div class="home-node__heading-row">
			<h2 id={titleId} class="home-section-title">
				<span class="home-section-title__icon"><Icon name={section.icon} /></span>
				{section.title}
			</h2>
			<a href={`/#${section.id}`} class="pattern-action-link">在工作台打开</a>
		</div>
		<p class="home-node__description">{section.description}</p>

		<ul class="home-section-list">
			{
				section.cards.map((card) => (
					<li class="home-section-item" data-access={card.access}>
						<span class="home-section-item__name">{card.name}</span>
						<span class="home-section-item__state" title={ACCESS_META[card.access].hint}>
							{ACCESS_META[card.access].label}
						</span>
					</li>
				))
			}
		</ul>

		<slot />
	</div>
</section>
