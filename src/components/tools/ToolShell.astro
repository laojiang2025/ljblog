---
import Icon from '../Icon.astro';
import { TOOLS } from '../../data/tools';

interface Props {
	active: string;
	title: string;
	description: string;
}

const { active, title, description } = Astro.props;
---

<div class="mx-auto grid w-full max-w-[1920px] grid-cols-[minmax(0,1fr)] gap-12 px-8 py-16 lg:px-16 2xl:px-20 md:grid-cols-[240px_minmax(0,1fr)] md:py-24">
	<aside class="min-w-0 overflow-hidden" aria-label="工具箱导航">
		<p class="hidden font-mono text-xs tracking-wide text-faint uppercase md:block">测试工具箱</p>
		<!-- 移动端横向滚动、桌面端纵向列表，同一份数据两种排布 -->
		<ul
			class="tool-nav-scroll mt-0 -mx-5 flex gap-1 overflow-x-auto px-5 pb-1 md:mx-0 md:mt-3 md:flex-col md:overflow-visible md:px-0 md:pb-0"
		>
			{
				TOOLS.map((tool) =>
					tool.href ? (
						<li class="shrink-0">
							<a
								class="flex items-center gap-2 rounded-lg px-3.5 py-2.5 text-sm whitespace-nowrap text-muted transition-colors hover:bg-surface-hover hover:text-foreground aria-[current=page]:bg-accent-soft aria-[current=page]:font-medium aria-[current=page]:text-accent"
								href={tool.href}
								aria-current={tool.id === active ? 'page' : undefined}
							>
								<Icon name={tool.icon} class="size-4 shrink-0" />
								<span>{tool.name}</span>
							</a>
						</li>
					) : (
						<li class="hidden shrink-0 md:block">
							<span
									class="flex items-center gap-2 px-3.5 py-2.5 text-sm whitespace-nowrap text-faint"
								title="仍在从本地工具迁移"
							>
								<Icon name={tool.icon} class="size-4 shrink-0" />
								<span>{tool.name}</span>
							</span>
						</li>
					),
				)
			}
		</ul>
	</aside>

	<div class="min-w-0">
		<header>
			<h1 class="text-3xl font-bold tracking-tight md:text-4xl">{title}</h1>
			<p class="mt-3 max-w-3xl text-base leading-relaxed text-muted">{description}</p>
		</header>
		<div class="mt-8">
			<slot />
		</div>
	</div>
</div>
