---
import { SITE, PRIMARY_NAV } from '../consts';

const pathname = Astro.url.pathname;

const isCurrent = (href: string) => {
	if (href === '/') return pathname === '/';
	return pathname.startsWith(href);
};
---


<header class="sticky top-0 z-50 border-b border-border bg-background/80 backdrop-blur-xl">
	<div class="mx-auto flex h-[5rem] w-full max-w-[1920px] items-center justify-between px-8 lg:px-16 2xl:px-20">
		<a class="flex items-baseline gap-2.5" href="/" aria-label={`${SITE.title}首页`}>
			<span class="grid size-8 place-items-center rounded-[10px] bg-foreground font-mono text-[11px] font-bold text-background">LJ</span>
			<span class="text-[17px] font-semibold tracking-tight">{SITE.title}</span>
			<span class="hidden font-mono text-xs uppercase tracking-[0.16em] text-faint sm:inline">{SITE.label}</span>
		</a>

		<div class="flex items-center gap-1.5">
			<nav class="hidden md:block" aria-label="主要导航">
				<ul class="flex items-center gap-1">
					{
						PRIMARY_NAV.map((link) => (
							<li>
								<a
									class="rounded-full px-4 py-2.5 text-base text-muted transition-colors hover:bg-surface-hover hover:text-foreground aria-[current=page]:bg-accent-soft aria-[current=page]:text-accent"
									href={link.href}
									aria-current={isCurrent(link.href) ? 'page' : undefined}
								>
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<button
				type="button"
				class="grid size-8 place-items-center rounded-md text-muted transition-colors hover:bg-surface-hover hover:text-foreground"
				data-theme-toggle
				aria-label="切换到深色模式"
				aria-pressed="false"
				title="切换到深色模式"
			>
				<svg
					class="size-4 dark:hidden"
					data-theme-icon="moon"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.75"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
				</svg>
				<svg
					class="hidden size-4 dark:block"
					data-theme-icon="sun"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.75"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<circle cx="12" cy="12" r="4"></circle>
					<path
						d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"
					></path>
				</svg>
			</button>

			<button
				type="button"
				class="grid size-8 place-items-center rounded-md text-muted transition-colors hover:bg-surface-hover hover:text-foreground md:hidden"
				data-open-mobile-nav
				aria-label="打开导航菜单"
				aria-haspopup="dialog"
			>
				<svg
					class="size-4"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.75"
					stroke-linecap="round"
					aria-hidden="true"
				>
					<path d="M4 7h16M4 12h16M4 17h16"></path>
				</svg>
			</button>
		</div>
	</div>
</header>

<dialog class="mobile-nav" data-mobile-nav aria-labelledby="mobile-nav-title">
	<div class="flex items-center justify-between border-b border-border px-4 py-3">
		<span class="text-sm font-medium" id="mobile-nav-title">网站导航</span>
		<button
			type="button"
			class="grid size-8 place-items-center rounded-md text-muted transition-colors hover:bg-surface-hover hover:text-foreground"
			data-close-mobile-nav
			aria-label="关闭导航菜单"
		>
			<svg
				class="size-4"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="1.75"
				stroke-linecap="round"
				aria-hidden="true"
			>
				<path d="m6 6 12 12M18 6 6 18"></path>
			</svg>
		</button>
	</div>
	<nav aria-label="手机导航">
		<ul class="p-2">
			{
				PRIMARY_NAV.map((link) => (
					<li>
						<a
							class="block rounded-md px-3 py-2.5 text-sm text-muted transition-colors hover:bg-surface-hover hover:text-foreground"
							href={link.href}
						>
							{link.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</dialog>
