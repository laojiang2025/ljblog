---
import BaseLayout from '../layouts/BaseLayout.astro';

// 双保险：本路由只会在 dev 命令下被注入（见 astro.config.mjs 的 adminDesk 集成），
// 万一未来有人把这个文件挪回 src/pages/，这行守卫仍能保证线上无内容
if (import.meta.env.PROD) return Astro.redirect('/');

const description = '本地写作台：在 astro dev 下写文章、维护产品与开源 Skills。';

const ICON_OPTIONS = [
	'flask', 'cpu', 'terminal', 'briefcase', 'grid', 'checklist', 'play', 'resume', 'book',
	'compass', 'database', 'clock', 'braces', 'bug', 'link', 'diff', 'mail',
];
---

<BaseLayout title="写作台" description={description} pageKind="landing">
	<meta name="robots" content="noindex, nofollow" slot="head" />
	<div class="mx-auto w-full max-w-[1100px] px-8 py-16 lg:py-20">
		<p class="page-kicker">Local admin</p>
		<h1 class="page-title">写作台</h1>
		<p class="page-lead">
			只在本地 <code class="rounded bg-surface-hover px-1.5 py-0.5 font-mono text-sm">astro dev</code>
			模式可用：写文章、维护产品与开源 Skills，保存直接写入项目文件，线上构建完全不包含本页。
		</p>

		<div
			class="mt-6 hidden rounded-[14px] border border-border bg-surface-hover px-4 py-3 text-sm text-muted"
			data-admin-offline
		>
			当前不是本地 dev 环境（或 dev 服务未启动），写作台无法保存。请在项目目录运行
			<code class="font-mono">astro dev</code> 后访问 <code class="font-mono">localhost:4321/admin/</code>。
		</div>

		<nav class="mt-10 flex gap-1.5 border-b border-border pb-3" aria-label="写作台功能">
			{
				[
					{ id: 'post', label: '写文章' },
					{ id: 'products', label: '产品' },
					{ id: 'tools', label: '工具' },
					{ id: 'courses', label: '课程' },
					{ id: 'skills', label: 'Skills' },
					{ id: 'sidebar', label: '侧边栏' },
				].map((tab, index) => (
					<button
						type="button"
						class="rounded-full px-4 py-2 text-sm font-medium text-muted transition-colors hover:bg-surface-hover hover:text-foreground aria-[selected=true]:bg-accent-soft aria-[selected=true]:text-accent"
						data-admin-tab={tab.id}
						aria-selected={index === 0 ? 'true' : 'false'}
					>
						{tab.label}
					</button>
				))
			}
		</nav>

		<!-- ── 写文章 ─────────────────────────── -->
		<section data-admin-panel="post">
			<form class="mt-8 grid gap-5" data-admin-form>
				<div class="grid gap-5 sm:grid-cols-2">
					<label class="grid gap-1.5">
						<span class="text-sm font-medium">标题 *</span>
						<input class="admin-input" name="title" required placeholder="文章标题" autocomplete="off" />
					</label>
					<label class="grid gap-1.5">
						<span class="text-sm font-medium">
							URL slug *
							<span class="ml-1 font-normal text-faint">（小写字母、数字、中划线）</span>
						</span>
						<input
							class="admin-input font-mono"
							name="slug"
							required
							pattern="[a-z0-9][a-z0-9-]*"
							placeholder="my-first-post"
							autocomplete="off"
						/>
					</label>
				</div>

				<label class="grid gap-1.5">
					<span class="text-sm font-medium">摘要 *<span class="ml-1 font-normal text-faint">（列表页与 SEO 描述）</span></span>
					<input class="admin-input" name="description" required placeholder="一两句话说清楚这篇文章讲什么" autocomplete="off" />
				</label>

				<div class="grid gap-5 sm:grid-cols-3">
					<label class="grid gap-1.5">
						<span class="text-sm font-medium">发布日期 *</span>
						<input class="admin-input font-mono" name="pubDate" type="date" required />
					</label>
					<label class="grid gap-1.5 sm:col-span-2">
						<span class="text-sm font-medium">标签<span class="ml-1 font-normal text-faint">（逗号分隔）</span></span>
						<input class="admin-input" name="tags" placeholder="AI, 测试, 效率" autocomplete="off" />
					</label>
				</div>

				<label class="grid gap-1.5">
					<span class="text-sm font-medium">正文（Markdown）</span>
					<textarea
						class="admin-input min-h-[420px] font-mono text-[14px] leading-relaxed"
						name="content"
						placeholder="## 从这里开始写&#10;&#10;支持全部 Markdown 语法。"></textarea>
					<span class="text-right font-mono text-xs text-faint" data-admin-count>0 字</span>
				</label>

				<div class="flex flex-wrap items-center gap-6">
					<label class="inline-flex items-center gap-2 text-sm">
						<input type="checkbox" name="draft" class="size-4 accent-current" />存为草稿（不出现在线上）
					</label>
					<label class="inline-flex items-center gap-2 text-sm">
						<input type="checkbox" name="overwrite" class="size-4 accent-current" />覆盖已有文章
					</label>
				</div>

				<div class="flex flex-wrap items-center gap-4">
					<button class="admin-btn" type="submit">保存文章</button>
					<p class="text-sm" data-admin-status role="status"></p>
				</div>
			</form>

			<section class="mt-14" aria-labelledby="admin-posts-title">
				<h2 id="admin-posts-title" class="text-lg font-semibold tracking-tight">已有文章</h2>
				<ul class="mt-4 divide-y divide-border" data-admin-posts>
					<li class="py-3 text-sm text-faint">加载中…</li>
				</ul>
			</section>
		</section>

		<!-- ── 产品 ─────────────────────────── -->
		<section data-admin-panel="products" hidden>
			<form class="mt-8 grid gap-5" data-products-form>
				<input type="hidden" name="id" />
				<div class="grid gap-5 sm:grid-cols-2">
					<label class="grid gap-1.5">
						<span class="text-sm font-medium">产品名称 *</span>
						<input class="admin-input" name="name" required placeholder="比如：测试工具箱" autocomplete="off" />
					</label>
					<label class="grid gap-1.5">
						<span class="text-sm font-medium">一句话定位 *</span>
						<input class="admin-input" name="tagline" required placeholder="它是干什么的，一句话" autocomplete="off" />
					</label>
				</div>
				<label class="grid gap-1.5">
					<span class="text-sm font-medium">补充说明</span>
					<input class="admin-input" name="description" placeholder="一两句话讲清楚它解决什么问题" autocomplete="off" />
				</label>
				<div class="grid gap-5 sm:grid-cols-4">
					<label class="grid gap-1.5">
						<span class="text-sm font-medium">状态</span>
						<select class="admin-input" name="status">
							<option value="online">在线（可访问）</option>
							<option value="building" selected>开发中</option>
						</select>
					</label>
					<label class="grid gap-1.5 sm:col-span-2">
						<span class="text-sm font-medium">链接<span class="ml-1 font-normal text-faint">（在线状态必填）</span></span>
						<input class="admin-input font-mono" name="href" placeholder="/tools/ 或 https://…" autocomplete="off" />
					</label>
					<label class="grid gap-1.5">
						<span class="text-sm font-medium">图标</span>
						<select class="admin-input font-mono" name="icon">
							{ICON_OPTIONS.map((icon) => <option value={icon}>{icon}</option>)}
						</select>
					</label>
				</div>
				<label class="grid gap-1.5">
					<span class="text-sm font-medium">标签<span class="ml-1 font-normal text-faint">（逗号分隔）</span></span>
					<input class="admin-input" name="tags" placeholder="在线工具, 测试效率" autocomplete="off" />
				</label>
				<div class="flex flex-wrap items-center gap-4">
					<button class="admin-btn" type="submit" data-products-submit>新增产品</button>
					<button class="admin-btn-ghost hidden" type="button" data-products-cancel>取消编辑</button>
					<p class="text-sm" data-products-status role="status"></p>
				</div>
			</form>

			<section class="mt-12" aria-labelledby="admin-products-title">
				<h2 id="admin-products-title" class="text-lg font-semibold tracking-tight">已有产品</h2>
				<ul class="mt-4 divide-y divide-border" data-products-list>
					<li class="py-3 text-sm text-faint">加载中…</li>
				</ul>
			</section>
		</section>

		<!-- ── 工具 ─────────────────────────── -->
		<section data-admin-panel="tools" hidden>
			<p class="mt-8 rounded-[14px] border border-border bg-surface-hover px-4 py-3 text-sm text-muted">
				这里维护「在线工具」列表的展示（名称、简介、图标、顺序、是否可用）。链接分两种：
				<strong>站内工具</strong>从下面「站内可选」里点一下自动填入（就是
				<code class="font-mono">src/pages/tools/</code> 里已经写好的页面，新页面需要写代码）；
				<strong>外部工具</strong>直接填完整的 https 地址，会在新标签页打开。
			</p>
			<form class="mt-6 grid gap-5" data-tools-form>
				<input type="hidden" name="id" />
				<div class="grid gap-5 sm:grid-cols-2">
					<label class="grid gap-1.5">
						<span class="text-sm font-medium">工具名称 *</span>
						<input class="admin-input" name="name" required placeholder="JSON 格式化" autocomplete="off" />
					</label>
					<label class="grid gap-1.5">
						<span class="text-sm font-medium">简介 *</span>
						<input class="admin-input" name="summary" required placeholder="一句话说明它做什么" autocomplete="off" />
					</label>
				</div>
				<div class="grid gap-5 sm:grid-cols-3">
					<label class="grid gap-1.5">
						<span class="text-sm font-medium">状态</span>
						<select class="admin-input" name="status">
							<option value="ready" selected>可用</option>
							<option value="pending">开发中</option>
						</select>
					</label>
					<label class="grid gap-1.5">
						<span class="text-sm font-medium">链接<span class="ml-1 font-normal text-faint">（可用状态必填）</span></span>
						<input
							class="admin-input font-mono"
							name="href"
							placeholder="点下方站内页面，或填 https://…"
							autocomplete="off"
							list="admin-tool-pages"
						/>
						<datalist id="admin-tool-pages"></datalist>
					</label>
					<label class="grid gap-1.5">
						<span class="text-sm font-medium">图标</span>
						<select class="admin-input font-mono" name="icon">
							{ICON_OPTIONS.map((icon) => <option value={icon}>{icon}</option>)}
						</select>
					</label>
				</div>
				<div class="flex flex-wrap items-center gap-2 text-sm" data-tool-pages>
					<span class="text-faint">站内可选：</span>
					<span class="text-faint">加载中…</span>
				</div>
				<div class="flex flex-wrap items-center gap-4">
					<button class="admin-btn" type="submit" data-tools-submit>新增工具</button>
					<button class="admin-btn-ghost hidden" type="button" data-tools-cancel>取消编辑</button>
					<p class="text-sm" data-tools-status role="status"></p>
				</div>
			</form>

			<section class="mt-12" aria-labelledby="admin-tools-title">
				<h2 id="admin-tools-title" class="text-lg font-semibold tracking-tight">当前工具</h2>
				<ul class="mt-4 divide-y divide-border" data-tools-list>
					<li class="py-3 text-sm text-faint">加载中…</li>
				</ul>
			</section>
		</section>

		<!-- ── 课程 ─────────────────────────── -->
		<section data-admin-panel="courses" hidden>
			<form class="mt-8 grid gap-5" data-courses-form>
				<input type="hidden" name="id" />
				<div class="grid gap-5 sm:grid-cols-2">
					<label class="grid gap-1.5">
						<span class="text-sm font-medium">课程名称 *</span>
						<input class="admin-input" name="name" required placeholder="AI 驱动的接口测试实战" autocomplete="off" />
					</label>
					<label class="grid gap-1.5">
						<span class="text-sm font-medium">一句话卖点 *</span>
						<input class="admin-input" name="tagline" required placeholder="学完能独立搭建 AI 测试工作流" autocomplete="off" />
					</label>
				</div>
				<label class="grid gap-1.5">
					<span class="text-sm font-medium">课程说明</span>
					<input class="admin-input" name="description" placeholder="内容大纲、适合人群，一两句话" autocomplete="off" />
				</label>
				<div class="grid gap-5 sm:grid-cols-4">
					<label class="grid gap-1.5">
						<span class="text-sm font-medium">状态</span>
						<select class="admin-input" name="status">
							<option value="live">已上线</option>
							<option value="prep" selected>筹备中</option>
						</select>
					</label>
					<label class="grid gap-1.5 sm:col-span-2">
						<span class="text-sm font-medium">报名 / 学习链接<span class="ml-1 font-normal text-faint">（上线必填）</span></span>
						<input class="admin-input font-mono" name="href" placeholder="https://…" autocomplete="off" />
					</label>
					<label class="grid gap-1.5">
						<span class="text-sm font-medium">价格<span class="ml-1 font-normal text-faint">（可留空）</span></span>
						<input class="admin-input font-mono" name="price" placeholder="￥199 / 免费" autocomplete="off" />
					</label>
				</div>
				<div class="grid gap-5 sm:grid-cols-3">
					<label class="grid gap-1.5">
						<span class="text-sm font-medium">分类<span class="ml-1 font-normal text-faint">（筛选按钮按分类自动生成）</span></span>
						<input class="admin-input" name="category" placeholder="训练营 / 专栏 / 1V1 咨询" autocomplete="off" />
					</label>
					<label class="grid gap-1.5">
						<span class="text-sm font-medium">封面图<span class="ml-1 font-normal text-faint">（public/ 下路径，可留空）</span></span>
						<input class="admin-input font-mono" name="cover" placeholder="/covers/ai-camp.png" autocomplete="off" />
					</label>
					<label class="grid gap-1.5">
						<span class="text-sm font-medium">标签<span class="ml-1 font-normal text-faint">（逗号分隔）</span></span>
						<input class="admin-input" name="tags" placeholder="AI 测试, 实战" autocomplete="off" />
					</label>
				</div>
				<div class="flex flex-wrap items-center gap-4">
					<button class="admin-btn" type="submit" data-courses-submit>新增课程</button>
					<button class="admin-btn-ghost hidden" type="button" data-courses-cancel>取消编辑</button>
					<p class="text-sm" data-courses-status role="status"></p>
				</div>
			</form>

			<section class="mt-12" aria-labelledby="admin-courses-title">
				<h2 id="admin-courses-title" class="text-lg font-semibold tracking-tight">当前课程</h2>
				<ul class="mt-4 divide-y divide-border" data-courses-list>
					<li class="py-3 text-sm text-faint">加载中…</li>
				</ul>
			</section>
		</section>

		<!-- ── Skills ─────────────────────────── -->
		<section data-admin-panel="skills" hidden>
			<form class="mt-8 grid gap-5" data-skills-form>
				<input type="hidden" name="id" />
				<div class="grid gap-5 sm:grid-cols-2">
					<label class="grid gap-1.5">
						<span class="text-sm font-medium">Skill 名称 *</span>
						<input class="admin-input" name="name" required placeholder="比如：api-contract-review" autocomplete="off" />
					</label>
					<label class="grid gap-1.5">
						<span class="text-sm font-medium">仓库地址<span class="ml-1 font-normal text-faint">（http(s) 开头）</span></span>
						<input class="admin-input font-mono" name="repo" placeholder="https://github.com/you/repo" autocomplete="off" />
					</label>
				</div>
				<label class="grid gap-1.5">
					<span class="text-sm font-medium">用途说明 *</span>
					<input class="admin-input" name="summary" required placeholder="这条 skill 帮 AI 助手做什么" autocomplete="off" />
				</label>
				<div class="grid gap-5 sm:grid-cols-2">
					<label class="grid gap-1.5">
						<span class="text-sm font-medium">安装 / 使用说明</span>
						<input class="admin-input font-mono" name="usage" placeholder="放进 .cursor/skills/ 即生效" autocomplete="off" />
					</label>
					<label class="grid gap-1.5">
						<span class="text-sm font-medium">标签<span class="ml-1 font-normal text-faint">（逗号分隔）</span></span>
						<input class="admin-input" name="tags" placeholder="接口测试, 评审" autocomplete="off" />
					</label>
				</div>
				<div class="flex flex-wrap items-center gap-4">
					<button class="admin-btn" type="submit" data-skills-submit>新增 Skill</button>
					<button class="admin-btn-ghost hidden" type="button" data-skills-cancel>取消编辑</button>
					<p class="text-sm" data-skills-status role="status"></p>
				</div>
			</form>

			<section class="mt-12" aria-labelledby="admin-skills-title">
				<h2 id="admin-skills-title" class="text-lg font-semibold tracking-tight">已有 Skills</h2>
				<ul class="mt-4 divide-y divide-border" data-skills-list>
					<li class="py-3 text-sm text-faint">加载中…</li>
				</ul>
			</section>
		</section>

		<!-- ── 侧边栏 ─────────────────────────── -->
		<section data-admin-panel="sidebar" hidden>
			<p class="mt-8 rounded-[14px] border border-border bg-surface-hover px-4 py-3 text-sm text-muted">
				这里维护网站右侧的悬浮工具栏。三种类型：<b>链接</b>（跳转站内外地址）、<b>弹出面板</b>（点击展开文字 +
				可选图片，适合公众号二维码）、<b>回顶部</b>。条目顺序即显示顺序，可用「上移」调整。
			</p>
			<form class="mt-6 grid gap-5" data-sidebar-form>
				<input type="hidden" name="id" />
				<div class="grid gap-5 sm:grid-cols-4">
					<label class="grid gap-1.5">
						<span class="text-sm font-medium">名称 *</span>
						<input class="admin-input" name="label" required placeholder="公众号" autocomplete="off" />
					</label>
					<label class="grid gap-1.5">
						<span class="text-sm font-medium">类型</span>
						<select class="admin-input" name="type">
							<option value="link" selected>链接</option>
							<option value="panel">弹出面板</option>
							<option value="top">回顶部</option>
						</select>
					</label>
					<label class="grid gap-1.5">
						<span class="text-sm font-medium">图标</span>
						<select class="admin-input font-mono" name="icon">
							{ICON_OPTIONS.map((icon) => <option value={icon}>{icon}</option>)}
						</select>
					</label>
					<label class="grid gap-1.5">
						<span class="text-sm font-medium">链接<span class="ml-1 font-normal text-faint">（链接类型必填）</span></span>
						<input class="admin-input font-mono" name="href" placeholder="/about/ 或 https://…" autocomplete="off" />
					</label>
				</div>
				<div class="grid gap-5 sm:grid-cols-3">
					<label class="grid gap-1.5">
						<span class="text-sm font-medium">面板标题</span>
						<input class="admin-input" name="panelTitle" placeholder="微信公众号" autocomplete="off" />
					</label>
					<label class="grid gap-1.5">
						<span class="text-sm font-medium">面板文字</span>
						<input class="admin-input" name="panelText" placeholder="扫码关注……" autocomplete="off" />
					</label>
					<label class="grid gap-1.5">
						<span class="text-sm font-medium">面板图片<span class="ml-1 font-normal text-faint">（public/ 下路径）</span></span>
						<input class="admin-input font-mono" name="panelImage" placeholder="/qr-wechat.png" autocomplete="off" />
					</label>
				</div>
				<div class="flex flex-wrap items-center gap-4">
					<button class="admin-btn" type="submit" data-sidebar-submit>新增条目</button>
					<button class="admin-btn-ghost hidden" type="button" data-sidebar-cancel>取消编辑</button>
					<p class="text-sm" data-sidebar-status role="status"></p>
				</div>
			</form>

			<section class="mt-12" aria-labelledby="admin-sidebar-title">
				<h2 id="admin-sidebar-title" class="text-lg font-semibold tracking-tight">当前侧边栏</h2>
				<ul class="mt-4 divide-y divide-border" data-sidebar-list>
					<li class="py-3 text-sm text-faint">加载中…</li>
				</ul>
			</section>
		</section>
	</div>
</BaseLayout>

<style>
	.admin-input {
		border: 1px solid var(--border);
		background: color-mix(in srgb, var(--surface) 88%, transparent);
		border-radius: 12px;
		padding: 0.65rem 0.9rem;
		font-size: 15px;
		color: var(--text);
		transition: border-color 0.15s ease;
	}
	.admin-input:focus {
		outline: none;
		border-color: var(--border-strong);
	}
	.admin-btn {
		display: inline-flex;
		align-items: center;
		height: 3rem;
		padding: 0 1.75rem;
		border-radius: 9999px;
		background: var(--text);
		color: var(--bg);
		font-size: 16px;
		font-weight: 500;
		transition: opacity 0.15s ease;
	}
	.admin-btn:hover {
		opacity: 0.85;
	}
	.admin-btn:disabled {
		opacity: 0.5;
	}
	.admin-btn-ghost {
		display: inline-flex;
		align-items: center;
		height: 3rem;
		padding: 0 1.5rem;
		border-radius: 9999px;
		border: 1px solid var(--border);
		color: var(--text-muted);
		font-size: 15px;
		transition: border-color 0.15s ease, color 0.15s ease;
	}
	.admin-btn-ghost:hover {
		border-color: var(--border-strong);
		color: var(--text);
	}
</style>

<script>
	type Dict = Record<string, unknown>;

	function initAdmin() {
		const root = document.querySelector<HTMLElement>('[data-admin-form]');
		if (!root || root.dataset.bound) return;
		root.dataset.bound = '1';

		const offlineEl = document.querySelector<HTMLElement>('[data-admin-offline]')!;
		const markOffline = () => offlineEl.classList.remove('hidden');
		const esc = (value: unknown) =>
			String(value ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

		/* ── 页签 ── */
		const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-admin-tab]')];
		const panels = [...document.querySelectorAll<HTMLElement>('[data-admin-panel]')];
		for (const tab of tabs) {
			tab.addEventListener('click', () => {
				tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
				panels.forEach((p) => (p.hidden = p.dataset.adminPanel !== tab.dataset.adminTab));
			});
		}

		/* ── 写文章 ── */
		const form = root as HTMLFormElement;
		const statusEl = document.querySelector<HTMLElement>('[data-admin-status]')!;
		const postsEl = document.querySelector<HTMLElement>('[data-admin-posts]')!;
		const contentEl = form.elements.namedItem('content') as HTMLTextAreaElement;
		const countEl = document.querySelector<HTMLElement>('[data-admin-count]')!;
		const dateEl = form.elements.namedItem('pubDate') as HTMLInputElement;
		if (!dateEl.value) dateEl.value = new Date().toISOString().slice(0, 10);

		const updateCount = () => (countEl.textContent = `${contentEl.value.length} 字`);
		contentEl.addEventListener('input', updateCount);
		updateCount();

		const setStatus = (el: HTMLElement, text: string, kind: 'ok' | 'err' | '' = '') => {
			el.textContent = text;
			el.style.color = kind === 'err' ? 'var(--warm, #c2410c)' : kind === 'ok' ? 'var(--accent)' : '';
		};

		const setField = (name: string, value: string) => {
			(form.elements.namedItem(name) as HTMLInputElement).value = value;
		};

		const loadPosts = async () => {
			try {
				const res = await fetch('/__admin/posts');
				const data = await res.json();
				if (!data.ok) throw new Error(data.error);
				postsEl.innerHTML = data.posts.length
					? ''
					: '<li class="py-3 text-sm text-faint">还没有文章。</li>';
				for (const post of data.posts) {
					const li = document.createElement('li');
					li.className = 'flex items-center justify-between gap-4 py-3';
					li.innerHTML = `<span class="min-w-0"><span class="block truncate text-sm font-medium">${esc(post.title)}</span><span class="font-mono text-xs text-faint">${esc(post.file)}</span></span>`;
					const btn = document.createElement('button');
					btn.type = 'button';
					btn.className =
						'shrink-0 rounded-full border border-border px-4 py-1.5 text-sm text-muted transition-colors hover:border-border-strong hover:text-foreground';
					btn.textContent = '编辑';
					btn.addEventListener('click', () => loadPost(post.slug));
					li.append(btn);
					postsEl.append(li);
				}
			} catch {
				markOffline();
				postsEl.innerHTML = '<li class="py-3 text-sm text-faint">dev 服务不可用，无法列出文章。</li>';
			}
		};

		const loadPost = async (slug: string) => {
			try {
				const res = await fetch(`/__admin/post?slug=${encodeURIComponent(slug)}`);
				const data = await res.json();
				if (!data.ok) throw new Error(data.error);
				const raw: string = data.raw;
				const m = raw.match(/^---\n([\s\S]*?)\n---\n?/);
				const fm = m?.[1] ?? '';
				const pick = (key: string) =>
					fm
						.match(new RegExp(`^${key}:\\s*(.+)$`, 'm'))?.[1]
						.trim()
						.replace(/^['"]|['"]$/g, '')
						.replace(/''/g, "'") ?? '';
				setField('title', pick('title'));
				setField('slug', slug);
				setField('description', pick('description'));
				const rawDate = pick('pubDate');
				setField('pubDate', /^\d{4}-\d{2}-\d{2}/.test(rawDate) ? rawDate.slice(0, 10) : '');
				setField(
					'tags',
					(fm.match(/^tags:\s*\[(.*)\]$/m)?.[1] ?? '')
						.split(',')
						.map((t) => t.trim().replace(/^['"]|['"]$/g, ''))
						.filter(Boolean)
						.join(', '),
				);
				(form.elements.namedItem('draft') as HTMLInputElement).checked = /^draft:\s*true$/m.test(fm);
				(form.elements.namedItem('overwrite') as HTMLInputElement).checked = true;
				contentEl.value = m ? raw.slice(m[0].length) : raw;
				updateCount();
				setStatus(statusEl, `已载入 ${slug}.md，保存会覆盖原文`, 'ok');
				form.scrollIntoView({ behavior: 'smooth' });
			} catch (e) {
				setStatus(statusEl, `载入失败：${e instanceof Error ? e.message : e}`, 'err');
			}
		};

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			const fd = new FormData(form);
			setStatus(statusEl, '保存中…');
			try {
				const res = await fetch('/__admin/save', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						title: fd.get('title'),
						slug: fd.get('slug'),
						description: fd.get('description'),
						pubDate: fd.get('pubDate'),
						tags: String(fd.get('tags') ?? '')
							.split(/[,，]/)
							.map((t) => t.trim())
							.filter(Boolean),
						draft: fd.get('draft') === 'on',
						overwrite: fd.get('overwrite') === 'on',
						content: fd.get('content'),
					}),
				});
				const data = await res.json();
				if (!data.ok) throw new Error(data.error);
				statusEl.innerHTML = `已保存 <code class="font-mono">${esc(data.file)}</code>，<a class="underline" href="${esc(data.url)}" target="_blank">打开文章 ↗</a>`;
				statusEl.style.color = 'var(--accent)';
				loadPosts();
			} catch (e) {
				const msg = e instanceof Error ? e.message : String(e);
				if (msg.includes('fetch')) markOffline();
				setStatus(statusEl, `保存失败：${msg}`, 'err');
			}
		});

		loadPosts();

		/* ── 产品 / Skills 数据管理 ── */
		interface ManagerConfig {
			kind: 'products' | 'skills';
			fields: string[];
			addLabel: string;
			updateLabel: string;
			rowHtml: (item: Dict) => string;
		}

		function setupManager({ kind, fields, addLabel, updateLabel, rowHtml }: ManagerConfig) {
			const mForm = document.querySelector<HTMLFormElement>(`[data-${kind}-form]`)!;
			const listEl = document.querySelector<HTMLElement>(`[data-${kind}-list]`)!;
			const mStatus = document.querySelector<HTMLElement>(`[data-${kind}-status]`)!;
			const submitBtn = document.querySelector<HTMLButtonElement>(`[data-${kind}-submit]`)!;
			const cancelBtn = document.querySelector<HTMLButtonElement>(`[data-${kind}-cancel]`)!;
			let items: Dict[] = [];

			const field = (name: string) => mForm.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement;

			const resetForm = () => {
				mForm.reset();
				field('id').value = '';
				submitBtn.textContent = addLabel;
				cancelBtn.classList.add('hidden');
			};

			const render = () => {
				listEl.innerHTML = items.length ? '' : '<li class="py-3 text-sm text-faint">还没有条目。</li>';
				items.forEach((item, index) => {
					const li = document.createElement('li');
					li.className = 'flex items-center justify-between gap-4 py-3';
					li.innerHTML = rowHtml(item);
					const actions = document.createElement('span');
					actions.className = 'flex shrink-0 gap-2';
					if (index > 0) {
						const upBtn = document.createElement('button');
						upBtn.type = 'button';
						upBtn.className =
							'rounded-full border border-border px-3 py-1.5 text-sm text-muted transition-colors hover:border-border-strong hover:text-foreground';
						upBtn.textContent = '↑';
						upBtn.title = '上移';
						upBtn.addEventListener('click', async () => {
							const next = [...items];
							[next[index - 1], next[index]] = [next[index], next[index - 1]];
							await persist(next, '已调整顺序');
						});
						actions.append(upBtn);
					}
					const editBtn = document.createElement('button');
					editBtn.type = 'button';
					editBtn.className =
						'rounded-full border border-border px-4 py-1.5 text-sm text-muted transition-colors hover:border-border-strong hover:text-foreground';
					editBtn.textContent = '编辑';
					editBtn.addEventListener('click', () => {
						for (const name of fields) {
							const el = field(name);
							if (el.type === 'checkbox') (el as HTMLInputElement).checked = Boolean(item[name]);
							else el.value = Array.isArray(item[name]) ? (item[name] as string[]).join(', ') : String(item[name] ?? '');
						}
						field('id').value = String(item.id ?? '');
						submitBtn.textContent = updateLabel;
						cancelBtn.classList.remove('hidden');
						mForm.scrollIntoView({ behavior: 'smooth' });
					});
					const delBtn = document.createElement('button');
					delBtn.type = 'button';
					delBtn.className =
						'rounded-full border border-border px-4 py-1.5 text-sm text-muted transition-colors hover:border-red-400 hover:text-red-500';
					delBtn.textContent = '删除';
					delBtn.addEventListener('click', async () => {
						if (!confirm(`确定删除「${item.name ?? item.label}」？`)) return;
						const next = items.filter((_, i) => i !== index);
						await persist(next, '已删除');
					});
					actions.append(editBtn, delBtn);
					li.append(actions);
					listEl.append(li);
				});
			};

			const persist = async (next: Dict[], okText: string) => {
				try {
					const res = await fetch(`/__admin/data?kind=${kind}`, {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ items: next }),
					});
					const data = await res.json();
					if (!data.ok) throw new Error(data.error);
					items = next;
					render();
					setStatus(mStatus, `${okText}（共 ${data.count} 条，已写入 ${data.file}）`, 'ok');
					return true;
				} catch (e) {
					const msg = e instanceof Error ? e.message : String(e);
					if (msg.includes('fetch')) markOffline();
					setStatus(mStatus, `保存失败：${msg}`, 'err');
					return false;
				}
			};

			mForm.addEventListener('submit', async (event) => {
				event.preventDefault();
				const entry: Dict = {};
				for (const name of fields) {
					const el = field(name);
					if (el.type === 'checkbox') entry[name] = (el as HTMLInputElement).checked;
					else if (name === 'tags')
						entry[name] = el.value
							.split(/[,，]/)
							.map((t) => t.trim())
							.filter(Boolean);
					else entry[name] = el.value.trim();
				}
				const editingId = field('id').value;
				entry.id = editingId || `${kind.slice(0, -1)}-${Date.now()}`;
				const next = editingId
					? items.map((item) => (item.id === editingId ? entry : item))
					: [...items, entry];
				if (await persist(next, editingId ? '已更新' : '已新增')) resetForm();
			});

			cancelBtn.addEventListener('click', resetForm);

			(async () => {
				try {
					const res = await fetch(`/__admin/data?kind=${kind}`);
					const data = await res.json();
					if (!data.ok) throw new Error(data.error);
					items = data.items;
					render();
				} catch {
					markOffline();
					listEl.innerHTML = '<li class="py-3 text-sm text-faint">dev 服务不可用，无法读取数据。</li>';
				}
			})();
		}

		setupManager({
			kind: 'products',
			fields: ['name', 'tagline', 'description', 'status', 'href', 'icon', 'tags'],
			addLabel: '新增产品',
			updateLabel: '保存修改',
			rowHtml: (item) =>
				`<span class="min-w-0"><span class="block truncate text-sm font-medium">${esc(item.name)}<span class="ml-2 font-mono text-xs ${item.status === 'online' ? 'text-accent' : 'text-faint'}">${item.status === 'online' ? 'online' : 'building'}</span></span><span class="block truncate text-[13px] text-muted">${esc(item.tagline)}</span></span>`,
		});

		setupManager({
			kind: 'skills',
			fields: ['name', 'summary', 'repo', 'usage', 'tags'],
			addLabel: '新增 Skill',
			updateLabel: '保存修改',
			rowHtml: (item) =>
				`<span class="min-w-0"><span class="block truncate text-sm font-medium">${esc(item.name)}${item.repo ? '<span class="ml-2 font-mono text-xs text-accent">repo ✓</span>' : '<span class="ml-2 font-mono text-xs text-faint">无仓库</span>'}</span><span class="block truncate text-[13px] text-muted">${esc(item.summary)}</span></span>`,
		});

		setupManager({
			kind: 'tools',
			fields: ['name', 'summary', 'status', 'href', 'icon'],
			addLabel: '新增工具',
			updateLabel: '保存修改',
			rowHtml: (item) =>
				`<span class="min-w-0"><span class="block truncate text-sm font-medium">${esc(item.name)}<span class="ml-2 font-mono text-xs ${item.status === 'ready' ? 'text-accent' : 'text-faint'}">${item.status === 'ready' ? 'ready' : 'pending'}</span></span><span class="block truncate text-[13px] text-muted">${esc(item.summary)}</span></span>`,
		});

		// 站内工具页扫描：datalist 提供输入建议，「站内可选」一键填入链接
		void (async () => {
			const chipBox = document.querySelector<HTMLElement>('[data-tool-pages]');
			const datalist = document.querySelector<HTMLDataListElement>('#admin-tool-pages');
			const hrefInput = document.querySelector<HTMLInputElement>('[data-tools-form] input[name="href"]');
			if (!chipBox || !datalist || !hrefInput) return;
			try {
				const res = await fetch('/__admin/toolpages');
				const data = (await res.json()) as { ok: boolean; pages?: { route: string }[] };
				if (!data.ok || !data.pages?.length) throw new Error('empty');
				datalist.innerHTML = data.pages.map((p) => `<option value="${esc(p.route)}"></option>`).join('');
				chipBox.innerHTML =
					'<span class="text-faint">站内可选：</span>' +
					data.pages
						.map(
							(p) =>
								`<button type="button" class="rounded-full border border-border px-2.5 py-0.5 font-mono text-xs text-muted transition-colors hover:border-border-strong hover:text-foreground" data-tool-page="${esc(p.route)}">${esc(p.route)}</button>`,
						)
						.join('');
				chipBox.addEventListener('click', (event) => {
					const btn = (event.target as HTMLElement).closest<HTMLElement>('[data-tool-page]');
					if (!btn) return;
					hrefInput.value = btn.dataset.toolPage ?? '';
					hrefInput.focus();
				});
			} catch {
				chipBox.innerHTML =
					'<span class="text-faint">站内页面列表加载失败，链接可手动填 /tools/xxx/ 或 https://…</span>';
			}
		})();

		setupManager({
			kind: 'courses',
			fields: ['name', 'tagline', 'description', 'category', 'cover', 'status', 'href', 'price', 'tags'],
			addLabel: '新增课程',
			updateLabel: '保存修改',
			rowHtml: (item) =>
				`<span class="min-w-0"><span class="block truncate text-sm font-medium">${esc(item.name)}<span class="ml-2 font-mono text-xs text-muted">${esc(item.category ?? '')}</span><span class="ml-2 font-mono text-xs ${item.status === 'live' ? 'text-accent' : 'text-faint'}">${item.status === 'live' ? 'live' : 'coming'}</span>${item.price ? `<span class="ml-2 font-mono text-xs text-muted">${esc(item.price)}</span>` : ''}</span><span class="block truncate text-[13px] text-muted">${esc(item.tagline)}</span></span>`,
		});

		const sidebarTypeLabel: Record<string, string> = { link: '链接', panel: '弹出面板', top: '回顶部' };
		setupManager({
			kind: 'sidebar',
			fields: ['label', 'type', 'icon', 'href', 'panelTitle', 'panelText', 'panelImage'],
			addLabel: '新增条目',
			updateLabel: '保存修改',
			rowHtml: (item) =>
				`<span class="min-w-0"><span class="block truncate text-sm font-medium">${esc(item.label)}<span class="ml-2 font-mono text-xs text-faint">${sidebarTypeLabel[String(item.type)] ?? item.type}</span></span><span class="block truncate font-mono text-xs text-muted">${esc(item.type === 'link' ? item.href : item.type === 'panel' ? item.panelTitle || item.panelText : '滚动到页面顶部')}</span></span>`,
		});
	}

	document.addEventListener('astro:page-load', initAdmin);
	initAdmin();
</script>
